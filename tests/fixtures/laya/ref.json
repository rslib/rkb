ry.", "ids": [50281, 79, 3941, 1953, 27, 9876, 436, 16507, 1361, 342, 436, 1895, 32, 50282, 50284, 3221, 27, 642, 13, 253, 3908, 1057, 417, 2186, 50284, 2032, 27, 4754, 13, 253, 3908, 6556, 50282, 28872, 27, 17011, 3806, 281, 362, 2420, 187, 1417, 251, 27, 187, 4, 1608, 8912, 21825, 2740, 19421, 6266, 187, 187, 817, 40561, 297, 187, 688, 7309, 13, 2634, 14769, 6266, 65, 10224, 342, 346, 48901, 27, 1621, 4454, 1119, 13, 2550, 6266, 2712, 449, 187, 187, 817, 32872, 187, 34, 20126, 19327, 1160, 342, 2634, 283, 16719, 337, 65, 556, 642, 14610, 285, 2761, 642, 2892, 15, 187, 187, 817, 22360, 187, 11202, 1200, 187, 14769, 20279, 1969, 328, 1200, 8912, 1969, 23059, 187, 11202, 187, 187, 817, 19594, 187, 510, 2715, 3213, 4817, 846, 253, 2628, 8264, 2147, 253, 2120, 2892, 15, 50282], "markers": [14, 24], "logits": [4.17475700378418, -0.19804775714874268]}, {"query": "undefined reference to vtable", "state": "problem: undefined reference to vtable\nlesson:\n# Squash fixups with autosquash\n\n## When to use\nWhen a review asks for small corrections to earlier commits in a branch.\n\n## Steps\n```sh\ngit commit --fixup=<sha>\ngit rebase -i --autosquash main\n```\n\n## Evidence\nEach fixup commit moved next to its target and was squashed into it.", "ids": [50281, 79, 3941, 1953, 27, 9876, 436, 16507, 1361, 342, 436, 1895, 32, 50282, 50284, 3221, 27, 642, 13, 253, 3908, 1057, 417, 2186, 50284, 2032, 27, 4754, 13, 253, 3908, 6556, 50282, 28872, 27, 17011, 3806, 281, 362, 2420, 187, 1417, 251, 27, 187, 4, 25399, 1225, 4993, 8777, 342, 1125, 375, 371, 1225, 187, 187, 817, 2091, 281, 897, 187, 3039, 247, 2278, 12325, 323, 1355, 17660, 281, 4321, 34588, 275, 247, 7789, 15, 187, 187, 817, 46854, 187, 11202, 1200, 187, 14769, 4514, 1969, 11097, 484, 30, 29, 20409, 31, 187, 14769, 294, 4793, 428, 74, 1969, 1920, 375, 371, 1225, 2022, 187, 11202, 187, 187, 817, 19594, 187, 11837, 4993, 484, 4514, 4395, 1735, 281, 697, 2303, 285, 369, 3896, 6948, 715, 352, 15, 50282], "markers": [14, 24], 